<?xml version="1.0" encoding="utf-8"?>
<!-- 单个宿主的状态卡片。移植自 squemaFQH 的 view_status_card.xml,但**结构上有两处改动**:

     1. 多了 status_card_package / status_card_version / status_card_logcat 三行:
        上游只有 title + subtitle + chip,包名与已安装版本根本没显示,而"这个宿主装的是哪个
        版本"恰恰是判断 install summary 该对上哪条审计基线的唯一依据(见 packs/FeaturePack.kt
        的 AUDITED_VERSION_CODES)。
     2. 去掉了上游的 status_card_targets 行(它被 MainActivity 无条件 setVisibility(GONE),
        是死视图)。

     卡片根 id 由 activity_main.xml 里 <include android:id="@+id/card_xxx"> 覆盖,
     所以两张卡共用这一份布局、各自的子 id 相同 —— 取值必须走 root.findViewById
     (MainActivity 就是这么做的,与上游同一个套路),不能直接 findViewById。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/status_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_glass_card_idle"
    android:clipToOutline="false"
    android:elevation="0dp"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">

            <View
                android:id="@+id/status_card_orb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_icon_orb"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/status_card_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/gold_bright"
                android:textSize="16sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/status_card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status_card_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/status_card_package"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_muted"
                android:textIsSelectable="true"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/status_card_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <!-- 这一行是**本版本唯一能看到 per-hook 明细的入口**:InstallSummary 算在宿主进程里,
                 host→module 没有可用 IPC(见 core/HookManager.kt 的 InstallSummary 注释),
                 所以把命令直接给到用户,让日志自己说话。必须可选中复制。 -->
            <TextView
                android:id="@+id/status_card_logcat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_gold"
                android:textIsSelectable="true"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status_card_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_chip_idle"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:textColor="@color/gold_bright"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
